            "type": "integer"
          },
          "finding_source": {
            "default": "code_review",
            "title": "Finding Source",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "issue_description": {
            "title": "Issue Description",
            "type": "string"
          },
          "issue_title": {
            "title": "Issue Title",
            "type": "string"
          },
          "line_number": {
