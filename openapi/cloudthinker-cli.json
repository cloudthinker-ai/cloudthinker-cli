            "title": "Access Token",
            "type": "string"
          },
          "app_id": {
            "nullable": true,
            "title": "App Id",
            "type": "string"
          },
          "backup_codes_remaining": {
            "nullable": true,
            "title": "Backup Codes Remaining",
            "type": "integer"
          },
          "device_trust_token": {
            "nullable": true,
            "title": "Device Trust Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "nullable": true,
            "title": "Expires At",
            "type": "string"
          },
          "invitation_accepted": {
            "default": false,
            "title": "Invitation Accepted",
            "type": "boolean"
          },
          "is_first_login": {
            "default": false,
            "title": "Is First Login",
            "type": "boolean"
          },
          "mfa_session_token": {
            "nullable": true,
            "title": "Mfa Session Token",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "nullable": true,
            "title": "Organization Id",
            "type": "string"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/UserOrganizationMinimal"
            },
            "nullable": true,
            "title": "Organizations",
            "type": "array"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "slack_oauth": {
            "default": false,
            "title": "Slack Oauth",
            "type": "boolean"
          },
          "team_id": {
            "nullable": true,
            "title": "Team Id",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "warnings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "nullable": true,
            "title": "Warnings",
            "type": "array"
          },
          "workspace_id": {
            "format": "uuid",
            "nullable": true,
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "Token",
        "type": "object"
      },
      "UserOrganizationMinimal": {
        "description": "Minimal organization info for user's organization list",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_owner": {
            "title": "Is Owner",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "is_owner"
        ],
        "title": "UserOrganizationMinimal",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Cloud Thinker",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/cli/runs": {
      "post": {
        "operationId": "cli-submit_headless_run",
        "parameters": [
          {
            "in": "query",
            "name": "workspace_id",
            "required": false,
            "schema": {
              "nullable": true,
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitHeadlessRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadlessRunSubmitted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Headless Run",
        "tags": [
          "cli"
        ]
      }
    },
    "/api/v1/cli/runs/{run_id}": {
      "get": {
        "operationId": "cli-get_headless_run",
        "parameters": [
          {
            "description": "Headless AgentRun id",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "description": "Headless AgentRun id",
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "workspace_id",
            "required": false,
            "schema": {
              "nullable": true,
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadlessRunStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Headless Run",
        "tags": [
          "cli"
        ]
      }
    },
    "/api/v1/code-review/merge-requests/lookup": {
      "get": {
        "description": "Resolve a CLI-pasted MR URL's coordinates to its tracked review detail.\n\nDeclared BEFORE /merge-requests/{merge_request_id} - FastAPI matches path\nsegments in registration order, so a route below that one would swallow\n\"lookup\" as a UUID path param and 422 instead of matching here.",
        "operationId": "code-review-lookup_code_review_merge_request",
        "parameters": [
          {
            "description": "Code review provider parsed from the MR URL",
            "in": "query",
            "name": "provider",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CodeReviewProvider"
            }
          },
          {
            "description": "Provider project path parsed from the MR URL",
            "in": "query",
            "name": "project_path",
            "required": true,
            "schema": {
              "description": "Provider project path parsed from the MR URL",
              "title": "Project Path",
              "type": "string"
            }
          },
          {
            "description": "MR/PR number parsed from the MR URL",
            "in": "query",
            "name": "mr_iid",
            "required": true,
            "schema": {
              "description": "MR/PR number parsed from the MR URL",
              "title": "Mr Iid",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "workspace_id",
            "required": false,
            "schema": {
              "nullable": true,
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeReviewMergeRequestDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lookup Code Review Merge Request",
        "tags": [
          "code-review"
        ]
      }
    },
    "/api/v1/login/cli/token": {
      "post": {
        "description": "Exchange a one-time code + PKCE verifier for a Token.\n\nAny failure (missing / expired code, verifier mismatch) returns the same\ngeneric 400 so a stolen code cannot be probed for its state (CA-SP-3).",
        "operationId": "login-exchange_cli_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CliTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Exchange Cli Token",
        "tags": [
          "login"
        ]
      }
    },
    "/api/v1/login/logout": {
      "post": {
        "description": "Logout user by revoking refresh token.\n\nThis is a best-effort operation that always succeeds. The refresh token is\nread from the httpOnly cookie first, falling back to the body for legacy\nclients. Auth cookies are always cleared. If the refresh token is invalid\nor already revoked, we still return success.",
        "operationId": "login-logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "login"
        ]
      }
    },
    "/api/v1/login/refresh": {
      "post": {
        "description": "Refresh access token with mandatory rotation.\nFollowing Auth0 best practices.\n\nThe refresh token is read from the httpOnly cookie first, falling back to\nthe request body for legacy header-based clients during the migration. The\norganization_id is derived from the workspace_id. If no workspace is\nprovided, falls back to the user's oldest active organization membership.",
        "operationId": "login-refresh_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh Token",
        "tags": [
          "login"
        ]
      }
    }
  }
}
