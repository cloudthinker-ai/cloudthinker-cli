{
	"name": "@cloudthinker/agent",
	"version": "0.1.0",
	"description": "The CloudThinker agent in your terminal, built on pi: pi's TUI hosted with @cloudthinker/cloud baked in, compiled to one binary per platform.",
	"type": "module",
	"license": "Apache-2.0",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"build": "bash scripts/build.sh"
	},
	"dependencies": {
		"@cloudthinker/cloud": "workspace:*",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@narumitw/pi-btw": "0.61.1",
		"@cloudthinker/subagents": "workspace:*",
		"beautiful-mermaid": "1.1.3",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "24.10.1",
		"@types/proper-lockfile": "4.1.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-tui": "*"
	}
}
