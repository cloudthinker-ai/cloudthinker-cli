{
	"name": "@cloudthinker/agent",
	"version": "0.1.0",
	"description": "The CloudThinker distribution of the pi coding agent: pi's TUI hosted with @cloudthinker/pi baked in, compiled to one binary per platform.",
	"type": "module",
	"license": "UNLICENSED",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"build": "bash scripts/build.sh"
	},
	"dependencies": {
		"@cloudthinker/pi": "workspace:*",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@tintinweb/pi-subagents": "0.19.0"
	},
	"devDependencies": {
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "24.10.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-tui": "*"
	}
}
