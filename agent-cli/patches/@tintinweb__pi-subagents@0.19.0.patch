--- /dev/null
+++ b/dist/host.js
@@ -0,0 +1,8 @@
+import { createAgentSession } from "@earendil-works/pi-coding-agent";
+let host;
+export function setSubagentHost(value) { host = value; }
+export function getSubagentHost() { return host; }
+
+export function createSubagentSession(options, ctx) {
+  return host?.createSession(options, ctx) ?? createAgentSession(options);
+}
